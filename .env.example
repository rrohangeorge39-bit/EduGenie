# Copy this file to ".env" and paste your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Optional: change the Gemini model without touching code.
# Google retires models often, so if you get a 404 "model not found",
# check https://ai.google.dev/gemini-api/docs/models and update this line.
GEMINI_MODEL=gemini-3.1-flash-lite
# Tried in order if the main model returns 404 / "no longer available"
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-2.5-flash

# Optional: local model used by the Explain feature
LOCAL_MODEL_NAME=MBZUAI/LaMini-Flan-T5-783M
